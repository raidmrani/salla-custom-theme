<section class="products-from-category">
  <h2>منتجات من تصنيف: {{ component.card.name }}</h2>

  {% if component.card and component.card.id %}
    <salla-products category-id="{{ component.card.id }}" limit="8">
      {% for product in products %}
        <div class="product-card">
          <img src="{{ product.image }}" alt="{{ product.name }}">
          <h3>{{ product.name }}</h3>
          <p>{{ product.price.formatted }}</p>
          <salla-add-product-button product-id="{{ product.id }}" />
        </div>
      {% endfor %}
    </salla-products>
  {% else %}
    <p>لم يتم اختيار أي تصنيف بعد.</p>
  {% endif %}
</section>
